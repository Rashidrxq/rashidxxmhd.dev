   "url": "https://github.com/Rashidrxq/SalesOrder-ERP-REMEX/blob/1abb51913e518dc3846a524a1baab3c92f74f1a4/sales_order/app/api/lib/invoice-storage.ts",
   "lines": [
    "import { mkdir, readFile, writeFile } from \"node:fs/promises\";",
    "import path from \"node:path\";",
    "import { randomUUID } from \"node:crypto\";",
    "",
    "const MAX_INVOICE_SIZE = 15 * 1024 * 1024;",
    "const storageRoot = path.join(process.cwd(), \"saleOrder_pdf_excel\");",
    "const allowedTypes = new Map([",
    "  [\".pdf\", [\"application/pdf\"]],",
    "  [\".xlsx\", [\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\", \"application/octet-stream\"]],",
    "  [\".xls\", [\"application/vnd.ms-excel\", \"application/octet-stream\"]],",
    "]);",
    "",
    "const safePart = (value: string) => value.replace(/[^a-zA-Z0-9._-]/g, \"_\").replace(/^\\.+/, \"_\");",
    "",
    "export async function saveInvoiceFile(orderNumber: string, file: File) {",
    "  const originalName = path.basename(file.name);",
    "  const extension = path.extname(originalName).toLowerCase();",
    "  const acceptedTypes = allowedTypes.get(extension);",
    "  if (!acceptedTypes || !acceptedTypes.includes(file.type)) throw new Error(\"Only PDF, XLS, and XLSX invoice files are allowed\");",
    "  if (!file.size) throw new Error(\"The invoice file is empty\");",
    "  if (file.size > MAX_INVOICE_SIZE) throw new Error(\"Invoice files must be 15 MB or smaller\");",
    "",
    "  const dateFolder = new Date().toISOString().slice(0, 10);",
    "  const orderFolder = safePart(orderNumber);",
    "  const fileName = `${safePart(path.basename(originalName, extension)) || \"invoice\"}-${randomUUID().slice(0, 8)}${extension}`;",
    "  const relativePath = path.join(dateFolder, orderFolder, fileName).replaceAll(\"\\\\\", \"/\");",
    "  const absolutePath = path.join(storageRoot, relativePath);",
    "  await mkdir(path.dirname(absolutePath), { recursive: true });",
    "  await writeFile(absolutePath, Buffer.from(await file.arrayBuffer()));",
    "",
    "  return { fileName: originalName, filePath: relativePath, fileType: file.type };",
    "}",
    "",
    "export async function readInvoiceFile(filePath: string) {",
    "  const root = path.resolve(storageRoot);",
    "  const absolutePath = path.resolve(storageRoot, filePath);",
    "  if (!absolutePath.startsWith(`${root}${path.sep}`)) throw new Error(\"Invalid invoice path\");",
    "  return readFile(absolutePath);",
    "}",
    "",
    "export const invoiceContentType = (fileName: string) => path.extname(fileName).toLowerCase() === \".pdf\" ? \"application/pdf\" : \"application/octet-stream\";",
    ""
   ]
  },
